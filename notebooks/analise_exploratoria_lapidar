        "        return np.nan\n",
        "    if d >= 0:\n",
        "        return \"Adequado/Adiantado\"\n",
        "    if d >= -2:\n",
        "        return \"Moderadamente defasado\"\n",
        "    return \"Severamente defasado\"\n",
        "\n",
        "df[\"Cat_Defasagem\"] = df[\"Defasagem\"].apply(categoriza_defasagem)\n",
        "df[[\"Ano\", \"RA\", \"Defasagem\", \"IAN\", \"Cat_Defasagem\"]].head()"
