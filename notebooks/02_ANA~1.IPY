   "source": [
    "corr_iaa_ida = df[\"IAA\"].corr(df[\"IDA\"])\n",
    "corr_iaa_ieg = df[\"IAA\"].corr(df[\"IEG\"])\n",
    "print(f\"Correlação IAA x IDA: {corr_iaa_ida:.2f}\")\n",
